# sample (default) is local-only. api enables real account/watchlist requests; no fallback.
VITE_DATA_SOURCE=sample
# Keep blank to use Vite's /api proxy locally; production can use same-origin routing.
VITE_API_BASE_URL=
# Development proxy target only; never put credentials in VITE_ variables.
API_PROXY_TARGET=http://127.0.0.1:4000
