PORT=4000
PRICE_TRACKING_ENABLED=false
PRICE_SCHEDULER_ENABLED=false
PRICE_RETRY_WORKER_ENABLED=false
ACCOUNT_MAIL_ENABLED=false
PRICE_EMAIL_ENABLED=false
PRICE_PUSH_ENABLED=false
# Delivery polls every 5 seconds; due price-run recovery every minute.
WORKER_POLL_INTERVAL_MS=5000
PRICE_RETRY_INTERVAL_MS=60000
# Required stable secret when opting into real tracking; at least 32 characters.
# TRACKING_CURSOR_SECRET=
# All live workers default OFF. Credentials do not activate them. Enabling a flag
# requires independent operator acceptance; it is NOT proof sending is safe.
# See docs/backend-runtime.md before any activation, including quota limitations.
HOST=127.0.0.1
# First origin is used for verification links; mail requires HTTPS.
# HTTP is local cookie development only. Production requires HTTPS for all entries.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a stable random value of at least 32 characters in production. Keep it
# server-side and stable across restarts/replicas; never generate it at startup.
# AUTH_JWT_SECRET=
# Optional: omit to run health-only without a database.
# MONGODB_URI=mongodb://127.0.0.1:27017/price_tracker
# Resend runtime configuration. Use a Sending Access key for the deployed API.
# RESEND_SEND_API_KEY=
# EMAIL_FROM=Price Tracker <alerts@your-verified-domain.example>
# Verification uses plain text. Reset/price workers require their matching
# template IDs when enabled. Verify published rendering/safety before activation.
# TEMPLATE_VERIFICATION_EMAIL_ID=
# TEMPLATE_PASSWORD_RESET_ID=
# TEMPLATE_PRICE_ALERT_ID=
# One-time local template setup only. Never deploy this Full Access key; revoke
# it after creating/publishing templates. Template setup scripts also need the
# Sending Access key above because testTemplateMail.ts initializes both clients.
# RESEND_FULL_ACCESS_API_KEY=
# RESEND_TEST_RECIPIENT=

# Optional until the approved free Firebase project is configured. Store service
# credentials outside the repository; never put them in a VITE_ setting.
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
