@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 17
skinparam shadowing false
skinparam classBackgroundColor #F1FAF9
skinparam classBorderColor #147D80
skinparam ArrowColor #48677A
hide methods
left to right direction
title MongoDB | core ownership and shared offer model
entity User {
 * _id
 --
 email <<unique>>
 passwordHash; emailVerifiedAt
 role; sessionVersion
}
entity Session {
 * _id
 --
 userId; transport; expiresAt
 revokedAt; secretHash; csrfHash
}
entity AuthToken {
 * _id
 --
 userId; purpose; tokenHash
 expiresAt; consumedAt
}
entity Device {
 * _id
 --
 userId; sessionId
 installationId <<unique>>
 pushToken <<unique>>; active
}
entity TrackedItem {
 * _id
 --
 userId; productId <<unique pair>>
 targetPriceMinor; currency
 alerts.email; alerts.push; enabled
 targetRevision; episodeId; episodeOpen
}
entity Product {
 * _id
 --
 provider; providerGameId
 storeId; market; currency
 steamAppId; dealId; purchaseUrl
 currentPriceMinor; lastSuccessfulCheckAt
}
entity PriceHistory {
 * _id
 --
 productId; checkId <<unique pair>>
 priceMinor; currency; observedAt
 providerChangedAt; dealId
}
entity NotificationDelivery {
 * _id
 --
 trackedItemId; episodeId; channel
 status; attempts; leaseUntil
 idempotencyKey; providerMessageId
}
User ||--o{ Session
User ||--o{ AuthToken
User ||--o{ Device
Session ||--o{ Device
User ||--o{ TrackedItem
Product ||--o{ TrackedItem
Product ||--o{ PriceHistory
TrackedItem ||--o{ NotificationDelivery
note bottom of Product
 Unique stable identity: provider + providerGameId + storeId + market + currency.
 Steam app and changing deal IDs are separate. Steam 1 / US / USD only.
end note
note bottom of NotificationDelivery
 Unique (trackedItemId, episodeId, channel); channel outcomes independent.
 All money is integer minor units. observedAt is not providerChangedAt.
end note
caption Core schema excerpt • history collection approval pending; model is not live-collection evidence
@enduml
