@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 18
skinparam shadowing false
skinparam activityBackgroundColor #F1FAF9
skinparam activityBorderColor #147D80
skinparam ArrowColor #48677A
title Alert evaluation | activity
start
:Scheduled run or admin-only manual run;
:Claim due shared offer with lease;
:Use cache / bounded provider budget;
:Fetch exact Steam offer via CheapShark;
if (Valid successful observation?) then (yes)
  :Persist observation and current offer;
  :Evaluate each enabled owned tracker;
  if (Price > target?) then (yes)
    :Close episode / rearm;
  else (no: price <= target)
    if (Episode already open?) then (yes)
      :No replay while qualifying;
    else (no)
      :Open episode; create eligible\nindependent channel deliveries;
      :Atomically claim each delivery;
      :Send email and/or push;
      if (Confirmed outcome?) then (yes)
        :Record channel result;
      else (unknown)
        :Preserve uncertainty; reconcile\ninstead of blind resend;
      endif
    endif
  endif
else (failure / 429 / missing offer)
  :Preserve last successful price;\nno zero, history, alert or rearm;
  :Honor Retry-After / bounded backoff;
endif
stop
caption Implementation model • target edits are not evidence of a sale
@enduml
