[Unit]
Description=Price Tracker API
After=network-online.target
Wants=network-online.target

[Service]
User=price-tracker
Group=price-tracker
WorkingDirectory=/srv/price-tracker/current/apps/api
EnvironmentFile=/etc/price-tracker/api.env
ExecStart=/opt/node-v24.22.1-linux-x64/bin/node /srv/price-tracker/current/apps/api/dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
